# ==============================================================================
# Evermind — Environment Configuration Template (.env.example)
# Copy to .env and configure for your environment (development or production).
# ==============================================================================

# Core Environment
ENVIRONMENT=development
NODE_ENV=development

# Web Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Django API Service
DJANGO_API_URL=http://127.0.0.1:8000
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-prod-evermind
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database + pgvector
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mediacompile
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mediacompile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis & Celery Message Broker
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional: Leave empty to disable storing redundant task results in Redis (state is persisted in PostgreSQL)
CELERY_RESULT_BACKEND=

# Object Storage (AWS S3 in production or MinIO for local development)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=evermind2026
AWS_S3_REGION_NAME=ap-south-1

# MinIO Object Storage (Development fallback when STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=mediacompile-uploads
MINIO_USE_SSL=false

# Auth.js Authentication
AUTH_SECRET=authjs-dev-secret-generate-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true

# Google OAuth Provider (Optional in dev, mandatory in production for Google Sign-In)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE_ID=

# Web-to-Django Internal Identity Bridge (HMAC-SHA256 Server-to-Server JWT)
INTERNAL_API_SECRET=development-internal-api-secret-key-must-be-min-32-chars
INTERNAL_API_ISSUER=evermind-web
INTERNAL_API_AUDIENCE=evermind-api

# LLM / Intelligence Provider (Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=3

# Embeddings & Search
WEB_SEARCH_ENABLED=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# File Ingestion & Networking Limits
MAX_UPLOAD_SIZE_MB=25
REQUEST_TIMEOUT_SECONDS=10
