{
  "manifest_version": 3,
  "name": "MediaCompile Web Clipper",
  "version": "1.0.0",
  "description": "Clip webpages, notes, and selected text into your private, searchable MediaCompile library with full user consent.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to MediaCompile"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
